{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperView",
  "version": "0.2.1",
  "identifier": "cn.stevenshen.paperview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperView",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "extensions/**/*",
      "assets/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/StevenShenPRC/PaperView/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQUM1MTU4RjhCRThGNTYKUldSV2o3NzRXRkdzNDhWYW1UcTFta1ZRV1BWNGNKUFJsemFPZDM0ajRhM3VBNkx5VnZjbUJMZFIK"
    }
  }
}